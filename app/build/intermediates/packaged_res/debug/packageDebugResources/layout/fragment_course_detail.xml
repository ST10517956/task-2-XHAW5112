<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/image_course_detail"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_photo_placeholder"
            tools:src="@drawable/img_canine_obedience"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/text_course_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/navy"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Canine Obedience Training" />

        <TextView
            android:id="@+id/text_course_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/teal"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Fee: R1500 · 6-month programme" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/includes"
            android:textColor="@color/navy"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_includes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            tools:text="• Basic commands\n• Leash training" />

        <TextView
            android:id="@+id/btn_add_booking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_coral"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/add_to_booking"
            android:textColor="@color/navy"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
